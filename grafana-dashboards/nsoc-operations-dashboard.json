      "targets": [
        {
          "dataset": "inventaire",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    -- Label : Téléphone | Lieu | Player ID | [Used / Total]\n    CONCAT(\n        f.phonenumberfield, \n        ' | \"', IFNULL(l.name, 'N/A'), \n        '\" | ID: ', IFNULL(a.tag, 'N/A'), \n        ' | (', f.datausedfield, ' / ', f.totaldatafield, ')'\n    ) AS 'metric',\n    \n    -- CALCUL DU RATIO (Consommé / Total) pour la progression de la barre\n    (CAST(REPLACE(f.datausedfield, ' Gb', '') AS DECIMAL(10,2)) / \n     NULLIF(CAST(REPLACE(f.totaldatafield, ' Gb', '') AS DECIMAL(10,2)), 0)) AS 'value'\n\nFROM \n    glpi_plugin_fields_computerdatas f\nJOIN \n    glpi_computers c ON f.items_id = c.id\nLEFT JOIN \n    glpi_locations l ON c.locations_id = l.id\nLEFT JOIN \n    glpi_agents a ON (a.items_id = c.id AND a.itemtype = 'Computer')\n\nWHERE \n    -- Filtre : On n'affiche que ceux qui ont consommé plus de 50%\n    CAST(REPLACE(f.percentfield, ' %', '') AS DECIMAL(5,2)) > 60\n    AND f.phonenumberfield <> 'Not Found'\n    -- Filtre : Données des 3 derniers jours uniquement\n    AND STR_TO_DATE(f.executiontimefield, '%d/%m/%Y %H:%i') >= DATE_SUB(CURDATE(), INTERVAL 3 DAY)\n\nORDER BY \n    value DESC;",
          "refId": "A",
          "sql": {
