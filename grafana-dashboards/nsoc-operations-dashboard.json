          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gc.name AS name, gl.latitude AS latitude, gl.longitude AS longitude, CASE WHEN gc.states_id = 1 THEN 1 WHEN gc.states_id = 7 THEN 0 END AS level, CASE WHEN gc.states_id = 1 THEN '✅ Operational' WHEN gc.states_id = 7 THEN '❌ Out of Service' END AS status, ga.last_contact AS \"Last Contact\" FROM glpi_computers AS gc INNER JOIN glpi_agents AS ga ON gc.id = ga.items_id AND ga.itemtype = 'Computer' INNER JOIN glpi_locations AS gl ON gc.locations_id = gl.id WHERE gl.latitude IS NOT NULL AND gl.longitude IS NOT NULL AND gc.is_deleted = 0 AND gc.states_id IN (1, 7) AND gl.name LIKE '%Dubai%';",
